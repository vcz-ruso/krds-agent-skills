      "name": "Default",
      "originalSource": "{\n  args: {\n    children: '기본 링크',\n    href: '#',\n    variant: undefined,\n    size: undefined\n  }\n}"
    },
    {
      "id": "components-link--variants",
      "name": "Variants",
      "originalSource": "{\n  args: {},\n  render: _args => <div style={{\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'flex-start',\n    gap: '16px'\n  }}>\n      <Link size=\"small\" href=\"#!\" icon={<i className=\"svg-icon ico-go\" />}>\n        기본 링크\n      </Link>\n\n      <Link size=\"medium\" href=\"#!\" preserveColorOnHover={true}>\n        가상클래스 상태 시 컬러 유지\n      </Link>\n\n      <Link size=\"large\" variant=\"basic\" href=\"#!\" icon={<i className=\"svg-icon ico-go\" />}>\n        본문 텍스트 컬러 링크\n      </Link>\n\n      <Link size=\"large\" variant=\"basic\" href=\"#!\" underline=\"hover\">\n        가상클래스 상태 시 밑줄\n      </Link>\n\n      <Link size=\"large\" variant=\"basic\" href=\"#!\" underline=\"none\">\n        밑줄 없음\n      </Link>\n    </div>\n}"
    },
    {
      "id": "components-link--sizes",
      "name": "Sizes",
      "originalSource": "{\n  args: {},\n  render: _args => <div style={{\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'flex-start',\n    gap: '16px'\n  }}>\n      <Link size=\"small\" href=\"#!\">\n        Small 크기 (14px)\n      </Link>\n      <Link size=\"medium\" href=\"#!\">\n        Medium 크기 (16px)\n      </Link>\n      <Link size=\"large\" href=\"#!\">\n        Large 크기 (18px)\n      </Link>\n    </div>\n}"
    },
    {
      "id": "components-link--underlines",
      "name": "Underlines",
      "originalSource": "{\n  args: {},\n  render: _args => <div style={{\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'flex-start',\n    gap: '16px'\n  }}>\n      <Link underline=\"always\" href=\"#!\">\n        항상 밑줄 표시\n      </Link>\n      <Link underline=\"hover\" href=\"#!\">\n        호버 시에만 밑줄 표시\n      </Link>\n      <Link underline=\"none\" href=\"#!\">\n        밑줄 없음\n      </Link>\n    </div>\n}"
    },
